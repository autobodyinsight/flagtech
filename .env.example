# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql://flagtech:change-me@localhost:5432/flagtech
# Hosted Postgres should use require. Local Postgres without SSL uses disable.
DATABASE_SSLMODE=disable

FLAGTECH_ENV=development
# Email that receives ARCHITECT access. Do not change this user from the app.
ARCHITECT_EMAIL=

# Optional: return password-reset tokens in the API response. Leave unset in production.
FLAGTECH_RETURN_RESET_TOKEN=

# Optional process tuning used by render.yaml / Docker.
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
